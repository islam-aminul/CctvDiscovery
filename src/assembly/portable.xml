<!-- The portable zip: the bundled runtime, the jar and a .cmd that starts
     them, without CctvDiscovery.exe. For computers whose policy blocks
     unknown executables, where the launcher and the self-extracting archive
     cannot run but a script starting a signed runtime can. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>portable</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>CctvDiscovery-${project.version}</baseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.build.directory}/dist</directory>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <exclude>*.exe</exclude>
            </excludes>
        </fileSet>
    </fileSets>
    <files>
        <!-- cmd.exe misreads labels in a script with bare LF line endings. -->
        <file>
            <source>src/main/packaging/CctvDiscovery.cmd</source>
            <outputDirectory>/</outputDirectory>
            <lineEnding>crlf</lineEnding>
        </file>
    </files>
</assembly>
